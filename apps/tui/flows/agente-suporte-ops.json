{
  "version": 1,
  "stopWhenSourcesDone": false,
  "description": "Agente de suporte/ops (ADR-008/ADR-009): nó único Input (padrão Chat, alternável para Aplicações via SCK ou Microfone via ASR Voxtral) alimenta agent.tools, que consulta runbooks locais (rag.search) e executa diagnósticos readonly (exec.command, dryRun=true) com aprovação humana em toda chamada de ferramenta. Resposta em português na conversa.",
  "nodes": [
    {
      "id": "input",
      "type": "capture.ffmpeg",
      "params": {
        "input": "",
        "chunkMs": 80,
        "backend": "chat",
        "placeholder": "Descreva o problema ou pedido de diagnóstico (Enter para enviar)..."
      }
    },
    {
      "id": "asr",
      "type": "asr.realtime",
      "params": {
        "model": "/Users/otaviolemos/.cache/huggingface/hub/models--mlx-community--Voxtral-Mini-4B-Realtime-2602-4bit/snapshots/fdebf7b2af834a1db4b8a3c99ab7480b333adf9e",
        "serverVad": true,
        "inputRate": 16000
      }
    },
    {
      "id": "exec_local",
      "type": "exec.command",
      "params": {
        "transport": "local",
        "mode": "readonly",
        "dryRun": true,
        "timeoutMs": 15000,
        "maxOutputBytes": 32768
      }
    },
    {
      "id": "rag_docs",
      "type": "rag.search",
      "params": {
        "toolName": "search_docs",
        "topK": 3,
        "maxChars": 2400
      }
    },
    {
      "id": "agente",
      "type": "agent.tools",
      "params": {
        "model": "LiquidAI--LFM3-1.7B-MLX-4bit",
        "approvalPolicy": "always",
        "maxSteps": 5,
        "enableThinking": false,
        "historyMax": 4,
        "historyCharBudget": 4000,
        "system": "Você é um agente SRE/Ops de suporte técnico. Use search_docs para consultar runbooks locais e exec_local para diagnósticos somente-leitura. Ao final, devolva um diagnóstico objetivo em português (2-4 frases) destacando causa raiz e próximo passo."
      }
    },
    {
      "id": "diagnostico",
      "type": "sink.captions",
      "params": {
        "mode": "callback",
        "showParcials": true
      }
    }
  ],
  "edges": [
    {
      "from": "input.out",
      "to": "asr.in",
      "capacity": 32,
      "overflow": "drop_oldest",
      "ttlMs": 1500
    },
    {
      "from": "asr.out",
      "to": "agente.parcs",
      "capacity": 16,
      "overflow": "drop_oldest"
    },
    {
      "from": "input.out_text",
      "to": "agente.in",
      "capacity": 8,
      "overflow": "block"
    },
    {
      "from": "exec_local.tool",
      "to": "agente.tools",
      "capacity": 8,
      "overflow": "block"
    },
    {
      "from": "rag_docs.tool",
      "to": "agente.tools",
      "capacity": 8,
      "overflow": "block"
    },
    {
      "from": "agente.out",
      "to": "diagnostico.in",
      "capacity": 16,
      "overflow": "drop_oldest"
    }
  ]
}
