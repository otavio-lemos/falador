{
  "version": 1,
  "stopWhenSourcesDone": false,
  "description": "Pipeline completo de interpretação por voz (nó único Input Aplicações/Microfone/Chat → STT → Tradução → TTS → Áudio): transcreve fala ou recebe texto, traduz para inglês natural, exibe a legenda na tela e sintetiza em voz alta no alto-falante.",
  "nodes": [
    {
      "id": "input",
      "type": "capture.ffmpeg",
      "params": {
        "input": "",
        "chunkMs": 80,
        "backend": "sck",
        "placeholder": "Digite texto para traduzir e falar em inglês (Enter para enviar)..."
      }
    },
    {
      "id": "asr",
      "type": "asr.realtime",
      "params": {
        "model": "/Users/otaviolemos/.cache/huggingface/hub/models--mlx-community--Voxtral-Mini-4B-Realtime-2602-4bit/snapshots/fdebf7b2af834a1db4b8a3c99ab7480b333adf9e",
        "serverVad": true,
        "inputRate": 16000
      }
    },
    {
      "id": "tradutor",
      "type": "translate.llm",
      "params": {
        "targetLanguage": "English",
        "enableThinking": false
      }
    },
    {
      "id": "legenda",
      "type": "sink.captions",
      "params": {
        "mode": "callback",
        "showParcials": true
      }
    },
    {
      "id": "voz",
      "type": "tts.sts",
      "params": {
        "url": "http://127.0.0.1:8091",
        "language": "English",
        "voice": "female",
        "speakOn": "final"
      }
    },
    {
      "id": "audio",
      "type": "sink.playback",
      "params": {
        "maxQueue": 4
      }
    }
  ],
  "edges": [
    {
      "from": "input.out",
      "to": "asr.in",
      "capacity": 32,
      "overflow": "drop_oldest",
      "ttlMs": 1500
    },
    {
      "from": "input.out_text",
      "to": "tradutor.in",
      "capacity": 16,
      "overflow": "drop_oldest"
    },
    {
      "from": "asr.out",
      "to": "tradutor.parcs",
      "capacity": 16,
      "overflow": "drop_oldest"
    },
    {
      "from": "tradutor.out",
      "to": "legenda.in",
      "capacity": 16,
      "overflow": "drop_oldest"
    },
    {
      "from": "tradutor.out",
      "to": "voz.in",
      "capacity": 8,
      "overflow": "block"
    },
    {
      "from": "voz.out",
      "to": "audio.in",
      "capacity": 8,
      "overflow": "block"
    }
  ]
}
