{
  "version": 1,
  "stopWhenSourcesDone": false,
  "description": "Tradução direta do áudio para português via LFM3-Audio (sem etapa separada de LLM): menor uso de memória, processa janelas de 12 s direto do áudio da call para legendas em PT.",
  "nodes": [
    {
      "id": "captura",
      "type": "capture.ffmpeg",
      "params": {
        "input": "",
        "chunkMs": 80,
        "backend": "sck"
      }
    },
    {
      "id": "asrtraduz",
      "type": "asr.lfm3",
      "params": {
        "url": "http://127.0.0.1:8091",
        "sampleRateHz": 16000,
        "flushSec": 12
      }
    },
    {
      "id": "legenda",
      "type": "sink.captions",
      "params": {
        "mode": "callback",
        "showParcials": true
      }
    }
  ],
  "edges": [
    {
      "from": "captura.out",
      "to": "asrtraduz.in",
      "capacity": 32,
      "overflow": "drop_oldest",
      "ttlMs": 1500
    },
    {
      "from": "asrtraduz.out",
      "to": "legenda.in",
      "capacity": 16,
      "overflow": "drop_oldest"
    }
  ]
}
