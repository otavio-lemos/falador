{
  "version": 1,
  "stopWhenSourcesDone": false,
  "description": "Tradutor universal — captura SCK → Voxtral ASR streaming → translate.llm (LFM3-1.7B) → sink.captions (legenda na tela, sem síntese de fala para não duplicar o áudio do Chrome). Qualquer idioma de entrada → português.",
  "nodes": [
    {
      "id": "capture1",
      "type": "capture.ffmpeg",
      "params": {
        "backend": "sck",
        "input": "",
        "chunkMs": 80,
        "isDefault": true
      }
    },
    {
      "id": "asr1",
      "type": "asr.realtime",
      "params": {
        "model": "mlx-community--Voxtral-Mini-4B-Realtime-2602-4bit",
        "serverVad": true,
        "inputRate": 16000,
        "outputRequired": false,
        "bargeInDebounceMs": 100,
        "commitEveryMs": 600,
        "silenceThresholdMs": 400,
        "maxPendingMs": 1200,
        "emitInterruptOnSpeech": true
      }
    },
    {
      "id": "sink1",
      "type": "sink.captions",
      "params": {
        "outputMode": "speak",
        "language": "English",
        "voice": "male",
        "playbackRate": 1.25,
        "isDefault": true,
        "model": "LFM3-Omni-2B-MLX-8bit",
        "showParcials": false,
        "mode": "callback"
      }
    }
  ],
  "edges": [
    {
      "from": "capture1.out",
      "to": "asr1.in",
      "capacity": 32,
      "overflow": "drop_oldest",
      "ttlMs": 1500
    },
    {
      "from": "asr1.out",
      "to": "sink1.in",
      "capacity": 16,
      "overflow": "block"
    }
  ]
}