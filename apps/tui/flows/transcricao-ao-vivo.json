{
  "version": 1,
  "stopWhenSourcesDone": false,
  "description": "Transcrição pura em tempo real (sem tradução ou LLM) com nó único Input (Aplicações via SCK, Microfone ou Chat): máxima velocidade e menor latência para acompanhar reuniões, palestras ou entrevistas no idioma original.",
  "nodes": [
    {
      "id": "input",
      "type": "capture.ffmpeg",
      "params": {
        "input": "",
        "chunkMs": 80,
        "backend": "sck",
        "placeholder": "Digite uma mensagem para exibir na transcrição (Enter para enviar)..."
      }
    },
    {
      "id": "asr",
      "type": "asr.realtime",
      "params": {
        "model": "/Users/otaviolemos/.cache/huggingface/hub/models--mlx-community--Voxtral-Mini-4B-Realtime-2602-4bit/snapshots/fdebf7b2af834a1db4b8a3c99ab7480b333adf9e",
        "serverVad": true,
        "inputRate": 16000
      }
    },
    {
      "id": "legenda",
      "type": "sink.captions",
      "params": {
        "mode": "callback",
        "showParcials": true
      }
    }
  ],
  "edges": [
    {
      "from": "input.out",
      "to": "asr.in",
      "capacity": 32,
      "overflow": "drop_oldest",
      "ttlMs": 1500
    },
    {
      "from": "input.out_text",
      "to": "legenda.phrase",
      "capacity": 16,
      "overflow": "drop_oldest"
    },
    {
      "from": "asr.out",
      "to": "legenda.in",
      "capacity": 16,
      "overflow": "drop_oldest"
    }
  ]
}
