{
  "version": 1,
  "stopWhenSourcesDone": false,
  "description": "Copilot para entrevista técnica (só texto, sem eco): captura a call via SCK, transcreve em tempo real, sugere resposta curta em 1ª pessoa no mesmo idioma da entrada (sem traduzir) e roteia via d1 entre exibição direta (auto) ou aprovação manual editável (humano).",
  "nodes": [
    {
      "id": "captura",
      "type": "capture.ffmpeg",
      "params": {
        "input": "",
        "chunkMs": 80,
        "backend": "sck"
      }
    },
    {
      "id": "asr",
      "type": "asr.realtime",
      "params": {
        "model": "/Users/otaviolemos/.cache/huggingface/hub/models--mlx-community--Voxtral-Mini-4B-Realtime-2602-4bit/snapshots/fdebf7b2af834a1db4b8a3c99ab7480b333adf9e",
        "serverVad": true,
        "inputRate": 16000
      }
    },
    {
      "id": "transcricao",
      "type": "sink.captions",
      "params": {
        "mode": "callback",
        "showParcials": true
      }
    },
    {
      "id": "assistente",
      "type": "llm.omlx",
      "params": {
        "enableThinking": false,
        "historyMax": 4,
        "temperature": 0.2,
        "system": "Você é um copilot de entrevista técnica. Com base na pergunta ou fala recebida, sugira uma resposta curta, objetiva e em 1ª pessoa NO MESMO IDIOMA da entrada recebida (nunca traduza para outro idioma). Responda em 2 a 3 frases diretas, sem comentários extras e sem repetir frases."
      }
    },
    {
      "id": "decisao",
      "type": "decision.llm",
      "params": {
        "options": [
          "auto",
          "humano"
        ],
        "defaultOption": "humano",
        "instructions": "Um assistente sugere uma resposta para o usuário falar numa entrevista técnica. Decida se a sugestão está PRONTA para ser falada sem revisão humana: 'auto' se é objetiva, técnica e curta; 'humano' se o usuário provavelmente vai querer editar.",
        "mode": "systemone",
        "model": "d1-2B-MLX-4bit",
        "criteria": {
          "auto": "Routine, factual or technical question the assistant can answer directly",
          "humano": "Sensitive, personal or ambiguous — the user must speak for themselves"
        }
      }
    },
    {
      "id": "sugestao",
      "type": "sink.captions",
      "params": {
        "mode": "callback",
        "showParcials": true
      }
    },
    {
      "id": "revisao",
      "type": "human.approve",
      "params": {}
    },
    {
      "id": "aprovada",
      "type": "sink.captions",
      "params": {
        "mode": "callback",
        "showParcials": true
      }
    }
  ],
  "edges": [
    {
      "from": "captura.out",
      "to": "asr.in",
      "capacity": 32,
      "overflow": "drop_oldest",
      "ttlMs": 1500
    },
    {
      "from": "asr.out",
      "to": "transcricao.in",
      "capacity": 64,
      "overflow": "drop_oldest"
    },
    {
      "from": "asr.final",
      "to": "assistente.in",
      "capacity": 16,
      "overflow": "drop_oldest"
    },
    {
      "from": "assistente.out",
      "to": "decisao.in",
      "capacity": 8,
      "overflow": "block"
    },
    {
      "from": "decisao.auto",
      "to": "sugestao.in",
      "capacity": 8,
      "overflow": "block"
    },
    {
      "from": "decisao.humano",
      "to": "revisao.in",
      "capacity": 8,
      "overflow": "block"
    },
    {
      "from": "revisao.out",
      "to": "aprovada.phrase",
      "capacity": 8,
      "overflow": "block"
    }
  ]
}
