{
  "version": 1,
  "stopWhenSourcesDone": false,
  "description": "Tradução simultânea EN → PT em tempo real (~1,1 s): captura o áudio da call (Teams, Zoom ou Meet) via SCK, transcreve com Voxtral streaming e traduz para português do Brasil natural em legendas ao vivo.",
  "nodes": [
    {
      "id": "captura",
      "type": "capture.ffmpeg",
      "params": {
        "input": "",
        "chunkMs": 80,
        "backend": "sck"
      }
    },
    {
      "id": "asr",
      "type": "asr.realtime",
      "params": {
        "model": "/Users/otaviolemos/.cache/huggingface/hub/models--mlx-community--Voxtral-Mini-4B-Realtime-2602-4bit/snapshots/fdebf7b2af834a1db4b8a3c99ab7480b333adf9e",
        "serverVad": true,
        "inputRate": 16000
      }
    },
    {
      "id": "tradutor",
      "type": "llm.omlx",
      "params": {
        "enableThinking": false,
        "historyMax": 0,
        "targetLanguage": "Portuguese",
        "template": [
          "Traduza para português do Brasil, natural e falado. Responda APENAS com a tradução."
        ]
      }
    },
    {
      "id": "legenda",
      "type": "sink.captions",
      "params": {
        "mode": "callback",
        "showParcials": true
      }
    }
  ],
  "edges": [
    {
      "from": "captura.out",
      "to": "asr.in",
      "capacity": 32,
      "overflow": "drop_oldest",
      "ttlMs": 1500
    },
    {
      "from": "asr.out",
      "to": "tradutor.parcs",
      "capacity": 16,
      "overflow": "drop_oldest"
    },
    {
      "from": "tradutor.out",
      "to": "legenda.in",
      "capacity": 16,
      "overflow": "drop_oldest"
    }
  ]
}
