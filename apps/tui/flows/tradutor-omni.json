{
  "version": 1,
  "stopWhenSourcesDone": false,
  "description": "Tradução nativa LFM3-Omni-2B (:8092): captura SCK (Chrome) → ASR+tradução nativa → Output (write padrão; speak via :8092).",
  "nodes": [
    {
      "id": "capture1",
      "type": "capture.ffmpeg",
      "params": {
        "backend": "sck",
        "input": "Google Chrome",
        "chunkMs": 80,
        "isDefault": true,
        "placeholder": "Digite sua mensagem ou comando (Enter para enviar)..."
      }
    },
    {
      "id": "asr2",
      "type": "asr.realtime.translate",
      "params": {
        "url": "http://127.0.0.1:8092",
        "model": "LiquidAI/LFM3-Omni-2B-MLX-8bit",
        "targetLanguage": "Portuguese",
        "sampleRateHz": 16000,
        "flushSec": 6
      }
    }
  ],
  "edges": [
    {
      "from": "capture1.out",
      "to": "asr2.in",
      "capacity": 32,
      "overflow": "drop_oldest",
      "ttlMs": 1500
    }
  ]
}