{
  "version": 1,
  "stopWhenSourcesDone": false,
  "description": "Cenário 1 (nativo): traduz DIRETO do áudio (LFM3-Audio task=chat), janelas de 12 s, ~15× rt, sem nó llm",
  "nodes": [
    {
      "id": "pipasist",
      "type": "capture.ffmpeg",
      "params": {
        "input": "BlackHole",
        "chunkMs": 80,
        "backend": "sounddevice"
      }
    },
    {
      "id": "asrtraduz",
      "type": "asr.lfm3",
      "params": {
        "url": "http://127.0.0.1:8091",
        "sampleRateHz": 16000,
        "flushSec": 12
      }
    },
    {
      "id": "legenda",
      "type": "sink.captions",
      "params": {
        "mode": "callback",
        "showParcials": true
      }
    }
  ],
  "edges": [
    {
      "from": "pipasist.out",
      "to": "asrtraduz.in",
      "capacity": 128,
      "overflow": "block"
    },
    {
      "from": "asrtraduz.out",
      "to": "legenda.in",
      "capacity": 16,
      "overflow": "drop_oldest"
    }
  ]
}
