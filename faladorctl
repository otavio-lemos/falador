#!/bin/bash
# faladorctl — controle ÚNICO dos serviços do Falador.
#   ./faladorctl {start|stop|restart|status}
# Sempre lista TODOS os serviços. Health/uso detalhado: ver run.md.
set -u
cd "$(dirname "$0")"
mkdir -p logs

REPO_DIR="$(pwd)"
SNAP_LFM3_AUDIO="$HOME/.cache/huggingface/hub/models--LiquidAI--LFM3-Audio-2B-MLX-8bit/snapshots/000ea4f93adbfdabd4b24295b5e838f6a1f0ffa8"
SNAP_VOXTRAL="$HOME/.cache/huggingface/hub/models--mlx-community--Voxtral-Mini-4B-Realtime-2602-4bit/snapshots/fdebf7b2af834a1db4b8a3c99ab7480b333adf9e"
VENV_PYTHON="$REPO_DIR/.venv/bin/python"

# Lista completa: todos os serviços residentes do projeto (run.md §1).
# Formato: nome|porta|health_path|comando|timeout_s
SERVICES=(
  "omlx|8080|/v1/models|omlx serve --model-dir \"$HOME/.omlx/models\" --host 127.0.0.1 --port 8080|30"
  "asr|8090|/v1/models|\"$VENV_PYTHON\" \"$REPO_DIR/.venv/lib/python3.12/site-packages/mlx_audio/server.py\" --host 127.0.0.1 --port 8090 --realtime-model \"$SNAP_VOXTRAL\"|60"
  "tts|8091|/health|\"$VENV_PYTHON\" services/sts-sidecar.py --model \"$SNAP_LFM3_AUDIO\" --port 8091|30"
  "web|8787|/api/catalog|node apps/web-server.mjs|15"
)

# Apenas processos em estado LISTEN na porta TCP (nunca sockets cliente/CLOSED como browser ou Orca Helper).
pids_at_port() { lsof -nP -ti "TCP:$1" -sTCP:LISTEN 2>/dev/null; }
pid_at_port() { pids_at_port "$1" | head -1; }

wait_up() { # nome porta health_path tries
  local port="$2" health="$3" tries="$4"
  for _ in $(seq 1 "$tries"); do
    curl -fsS -m 1 "http://127.0.0.1:$port$health" -o /dev/null 2>/dev/null && return 0
    sleep 1
  done
  return 1
}

names() { for s in "${SERVICES[@]}"; do IFS='|' read -r name _ _ _ _ <<< "$s"; printf "%s " "$name"; done; echo; }

cmd_status() {
  echo "Serviços do Falador ($(names | wc -w | tr -d ' ')): $(names)"
  local all_ok=1
  for s in "${SERVICES[@]}"; do
    IFS='|' read -r name port _ _ _ <<< "$s"
    local p what
    p=$(pid_at_port "$port")
    if [ -n "$p" ]; then
      what=$(ps -p "$p" -o command= 2>/dev/null | head -c 70)
      echo "  ✔ $name :$port (pid $p) — $what"
    else
      echo "  ✖ $name :$port PARADO"
      all_ok=0
    fi
  done
  [ "$all_ok" -eq 1 ] && echo "=> tudo no ar. UI: http://127.0.0.1:8787" \
                    || echo "=> há serviços parados (./faladorctl start)"
}

cmd_start() {
  # rebuild da UI antes de subir (evita servir dist stale)
  if [ -d apps/web ]; then
    echo "Build da UI (apps/web)..."
    (cd apps/web && npm run build) > logs/build.log 2>&1 \
      && echo "  ✔ build ok (logs/build.log)" \
      || { echo "  ✖ build falhou — veja logs/build.log"; exit 1; }
  fi
  echo "Subindo TODOS os serviços: $(names)"
  for s in "${SERVICES[@]}"; do
    IFS='|' read -r name port _ cmd tries <<< "$s"
    if [ -n "$(pid_at_port "$port")" ]; then
      echo "  $name :$port já no ar (pid $(pid_at_port "$port"))"
      continue
    fi
    echo "  subindo $name :$port ..."
    nohup bash -c "$cmd" >> "logs/$name.log" 2>&1 &
    disown
  done
  local ok=1
  echo "esperando responderem (carga de modelo: ASR é o mais lento)..."
  for s in "${SERVICES[@]}"; do
    IFS='|' read -r name port health cmd tries <<< "$s"
    if wait_up "$name" "$port" "$health" "$tries"; then
      echo "  ✔ $name :$port respondeu"
    else
      echo "  ✖ $name :$port NÃO respondeu após ${tries}s — logs/$name.log:"
      tail -3 "logs/$name.log" 2>/dev/null | sed 's/^/      /'
      ok=0
    fi
  done
  [ "$ok" -eq 1 ] && echo "=> tudo no ar. UI: http://127.0.0.1:8787" \
                  || { echo "=> FALHA PARCIAL — veja logs/"; exit 1; }
}

cmd_stop() {
  echo "Derrubando TODOS os serviços: $(names)"
  for s in "${SERVICES[@]}"; do
    IFS='|' read -r name port _ _ _ <<< "$s"
    local pids; pids=$(pids_at_port "$port")
    if [ -n "$pids" ]; then
      for p in $pids; do
        kill "$p" 2>/dev/null
        echo "  ✔ $name :$port (pid $p) → SIGTERM"
      done
    else
      echo "  – $name :$port já estava parado"
    fi
  done
  # espera morrer de verdade; SIGKILL só no teimoso
  for _ in $(seq 1 20); do
    local vivos=0
    for s in "${SERVICES[@]}"; do
      IFS='|' read -r name port _ _ _ <<< "$s"
      [ -n "$(pid_at_port "$port")" ] && vivos=1
    done
    [ "$vivos" -eq 0 ] && break
    sleep 0.5
  done
  for s in "${SERVICES[@]}"; do
    IFS='|' read -r name port _ _ _ <<< "$s"
    local pids; pids=$(pids_at_port "$port")
    if [ -n "$pids" ]; then
      for p in $pids; do
        kill -9 "$p" 2>/dev/null
        echo "  ✔ $name :$port (pid $p) teimou → SIGKILL"
      done
    fi
  done
  echo "=> todos parados."
}

cmd_restart() {
  cmd_stop
  # porta em TIME_WAIT pós-SIGKILL: espera liberar antes de subir
  for s in "${SERVICES[@]}"; do
    IFS='|' read -r name port _ _ _ <<< "$s"
    for _ in $(seq 1 10); do [ -z "$(pid_at_port "$port")" ] && break || sleep 0.5; done
  done
  cmd_start
}

case "${1:-}" in
  status)  cmd_status ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  *)
    echo "faladorctl — controle dos serviços do Falador"
    echo "serviços: $(names)"
    echo "uso: ./faladorctl {start|stop|restart|status}"
    exit 2 ;;
esac